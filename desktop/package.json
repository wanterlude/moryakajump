{
  "name": "moryaka-jump",
  "version": "1.0.45",
  "description": "Moryaka Jump — зимний бесконечный платформер",
  "author": "Wanterlude",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare:app": "node prepare.js",
    "dist": "npm run prepare:app && electron-builder --win portable",
    "release": "npm run dist && node release.js"
  },
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.wanterlude.moryakajump",
    "productName": "Moryaka Jump",
    "artifactName": "Moryaka-Jump-${version}.exe",
    "directories": {
      "output": "build-out"
    },
    "files": [
      "main.js",
      "index.html",
      "icon.ico",
      "*.jpg"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "ru"
    ]
  }
}
